<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="14dp"
    app:cardElevation="2dp"
    app:strokeColor="@color/routrip_blue_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="112dp"
        android:orientation="horizontal"
        android:padding="16dp">

        <ImageView
            android:id="@+id/imagemAtividade"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/icon_background"
            android:contentDescription="@string/imagem_atividade"
            android:padding="14dp"
            app:tint="@color/routrip_blue" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tituloAtividade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/routrip_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/categoriaAtividade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/routrip_blue"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/descricaoAtividade"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:textColor="@color/routrip_text_secondary"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
